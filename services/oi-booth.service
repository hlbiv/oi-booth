[Unit]
Description=oi-booth photo booth (pibooth)
After=network.target graphical-session.target

[Service]
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=PYTHONPATH=/home/pi/oi-booth
WorkingDirectory=/home/pi/oi-booth
ExecStart=/home/pi/oi-booth/venv/bin/pibooth
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
