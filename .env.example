# Copy to .env and edit for your setup

# ── Web server ────────────────────────────────────────────────────────────────
OI_PORT=5000
OI_HOST=0.0.0.0
OI_SECRET_KEY=change-me-in-production

# ── Auth ──────────────────────────────────────────────────────────────────────
# 4-digit PIN for the admin panel (default 1234 — change this!)
OI_ADMIN_PIN=1234

# ── Storage ───────────────────────────────────────────────────────────────────
OI_STORAGE_DIR=/media/usb/oi-booth-photos
OI_BACKGROUNDS_DIR=/home/pi/.config/pibooth/backgrounds
OI_OVERLAYS_DIR=/home/pi/.config/pibooth/overlays
PIBOOTH_CFG=/home/pi/.config/pibooth/pibooth.cfg

# ── Events ────────────────────────────────────────────────────────────────────
OI_EVENTS_DIR=/home/pi/.config/pibooth/events

# ── Attract slideshow ─────────────────────────────────────────────────────────
OI_ATTRACT_DIR=/home/pi/.config/pibooth/attract

# ── Email sharing (optional — leave blank to disable) ────────────────────────
OI_MAIL_SERVER=smtp.gmail.com
OI_MAIL_PORT=587
OI_MAIL_USERNAME=you@gmail.com
OI_MAIL_PASSWORD=your-app-password
OI_MAIL_FROM=oi-booth <you@gmail.com>

# ── OTA update (path to repo root for git pull) ───────────────────────────────
OI_REPO_DIR=/home/pi/oi-booth
