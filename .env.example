# Copy to .env and edit for your setup
OI_PORT=5000
OI_HOST=0.0.0.0
OI_SECRET_KEY=change-me-in-production
OI_STORAGE_DIR=/media/usb/oi-booth-photos
OI_BACKGROUNDS_DIR=/home/pi/.config/pibooth/backgrounds
OI_OVERLAYS_DIR=/home/pi/.config/pibooth/overlays
PIBOOTH_CFG=/home/pi/.config/pibooth/pibooth.cfg
